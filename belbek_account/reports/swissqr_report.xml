<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="l10n_ch_swissqr_template" inherit_id="l10n_ch.l10n_ch_swissqr_template" >
            <xpath expr="//div[@id='receipt_indication_zone']//span[@t-out='company.name']" position="replace">
                <span t-if="company.ch_qr_name" t-out="company.ch_qr_name"/>
                <span t-else="" t-out="company.name"/>
            </xpath>



            <xpath expr="//div[@id='indications_zone']//span[@t-out='company.name']" position="replace">
                <span t-if="company.ch_qr_name" t-out="company.ch_qr_name"/>
                <span t-else="" t-out="company.name"/>
            </xpath>
        </template>

    </data>
</odoo>
